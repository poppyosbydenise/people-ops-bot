# Slack (from api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Slack user IDs (click profile → ⋮ → Copy member ID)
SLACK_USER_ALEX=U0XXXXXXXXX
SLACK_USER_SAM=U0XXXXXXXXX

# Slack channel ID for #people-ops-tasks
# Right-click the channel → View channel details → copy the ID at the bottom (starts with C)
SLACK_CHANNEL_ID=C0XXXXXXXXX

# Google Sheets
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_SHEET_TAB=Tasks

# Path to Google service account credentials JSON
GOOGLE_CREDENTIALS_PATH=./credentials.json
# OR paste the JSON directly (for Railway / cloud deploy):
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# HTTP endpoint secret (cron-job.org uses this to authenticate triggers)
NOTIFY_SECRET=changeme

# Port (Railway sets this automatically)
PORT=3000
